# Outside Inmates uses its own Supabase project. Do not copy credentials from another site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hosted deployment runtime aliases. Locally, the NEXT_PUBLIC values above are sufficient.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SITE_URL=http://localhost:3000
